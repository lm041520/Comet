# ============ 根 .env.example（docker-compose 用）============
# 复制为 .env：  copy .env.example .env

# ---- 应用 ----
APP_NAME=Comet
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ---- 安全 ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key

# ---- PostgreSQL ----
POSTGRES_USER=comet
POSTGRES_PASSWORD=comet
POSTGRES_DB=comet

# ---- Neo4j ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=cometneo4j

# 说明：容器间地址（POSTGRES_HOST/ES_HOST/NEO4J_URI/REDIS_URL 等）
# 已在 docker-compose.yml 的 environment 中覆盖为服务名，无需在此设置。
# 本地裸跑后端时，请用 api/.env.example 里的 localhost 配置。

# ---- RAG / Docling 离线模型 ----
# 容器内路径；宿主机目录 api/storage 会挂载到 /app/storage。
RAG_DOCLING_ENABLED=true
RAG_DOCLING_DO_OCR=true
RAG_DOCLING_CACHE_DIR=/app/storage/docling-models
